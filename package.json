{
  "name": "ts-engineer-bootcamp",
  "type": "module",
  "private": true,
  "scripts": {
    "typecheck": "bun check",
    "lint": "biome check .",
    "format": "bun fmt",
    "test:solutions": "SOLUTIONS=1 bun test",
    "verify": "bun check && biome check . && bun fmt --check && SOLUTIONS=1 bun test",
    "site:build": "bun site/build.ts",
    "site:dev": "bun site/build.ts && bun site/serve.ts",
    "study": "bun site/build.ts && bun site/study.ts",
    "site:check": "bun site/build.ts --registry-only && bun check -p site"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "animejs": "^4.5.0"
  }
}
